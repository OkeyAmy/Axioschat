# Python virtual environment (not needed for Vercel)
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Python files in api directory (not serverless functions)
api/*.py
requirements.txt

# Pre-built outputs (Vercel will build fresh)
dist/
dist-ssr/
.next/
out/
build/

# Dependencies (will be installed by Vercel)
node_modules/

# Documentation (keep README)
docs/
*.md
!README.md

# Development scripts (not needed for deployment)
scripts/
*.ps1
*.sh

# Development files
.vscode/
.idea/
*.log
*.local

# Environment files (should be set in Vercel dashboard)
.env
.env.*

# Cache directories
.cache/
*.cache/

